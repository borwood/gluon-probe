{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gluon:schema:0.1.0",
  "title": "Gluon discovery protocol (experimental)",
  "description": "Calls: describe(scope) -> ScopeDescription (configuration plus SPARQL fragments; never touches the graph); probe(scope, type, text|iri[, filters, snapshot]) -> ProbeReport where text is one expression or a list of alternatives; inspect(scope, iri[, profile | direction, predicate][, snapshot]) -> InspectReport; inspect_many(scope, iris, ...) -> {scope, snapshot, reports}; labels(scope, iris[, snapshot]) -> LabelsReport; replay(record[, snapshot]) re-executes a stored search record; diff_reports(before, after) lists added/removed matches. Reuse a term id from describe as probe.type. A no_match outcome with complete=true is absence of evidence in this scope and snapshot, never proof of nonexistence. Qualifier names and values are opaque host data; null means not recorded in this snapshot. Every report carries the complete scoped SELECT it executed (query) and a self-contained record a host can store and replay.",
  "protocol": {
    "steps": ["describe", "probe", "inspect", "labels", "handoff"],
    "handoff": "Execute report.query through the host executor with the same source/scope/graph/snapshot. In rows mode take at most completeness.row_limit rows; the extra fetched row is a truncation sentinel. For probe, group rows by ?entity plus the expand-mode qualifier variables, deduplicate labels and collect collect-mode qualifiers. In entities mode the inner subquery bounds distinct entities (entity_limit) and the outer LIMIT bounds rows (row_limit). Compose your own SELECT from describe.sparql.terms[<term>].pattern inside GRAPH <describe.sparql.graph> { ... }.",
    "diagnostics": "DiscoveryError.code is one of ErrorCode; path/detail/options describe your own input and are absent for source-side failures."
  },
  "$defs": {
    "Iri": {"type": "object", "required": ["type", "value"], "additionalProperties": false,
            "properties": {"type": {"const": "iri"}, "value": {"type": "string"}}},
    "Literal": {"type": "object", "required": ["type", "value"], "additionalProperties": false,
                "properties": {"type": {"const": "literal"}, "value": {"type": "string"},
                               "datatype": {"type": "string"}, "language": {"type": "string"},
                               "truncated": {"type": "boolean", "description": "Value cut to limits.literal_chars"},
                               "length": {"type": "integer", "description": "Original length when truncated"}}},
    "Variable": {"type": "object", "required": ["type", "value"], "additionalProperties": false,
                 "properties": {"type": {"const": "variable"}, "value": {"type": "string"}}},
    "ScopedBlank": {"type": "object", "required": ["type", "value", "scope"], "additionalProperties": false,
                    "properties": {"type": {"const": "blank"}, "value": {"type": "string"}, "scope": {"type": "string"}}},
    "Constant": {"oneOf": [{"$ref": "#/$defs/Iri"}, {"$ref": "#/$defs/Literal"}]},
    "TriplePattern": {"type": "object", "required": ["subject", "predicate", "object"], "additionalProperties": false,
                      "properties": {"subject": {"oneOf": [{"$ref": "#/$defs/Iri"}, {"$ref": "#/$defs/Variable"}]},
                                     "predicate": {"$ref": "#/$defs/Iri"},
                                     "object": {"oneOf": [{"$ref": "#/$defs/Iri"}, {"$ref": "#/$defs/Variable"}, {"$ref": "#/$defs/Literal"}]}}},
    "Qualifier": {"type": "object", "required": ["name", "subject", "predicate", "object"], "additionalProperties": false,
                  "description": "One triple pattern attached to ?entity, a constant, or a variable the binding patterns bind; exactly one end is the variable named `name`. Names and values are opaque.",
                  "properties": {"name": {"type": "string"},
                                 "subject": {"oneOf": [{"$ref": "#/$defs/Iri"}, {"$ref": "#/$defs/Variable"}]},
                                 "predicate": {"$ref": "#/$defs/Iri"},
                                 "object": {"oneOf": [{"$ref": "#/$defs/Iri"}, {"$ref": "#/$defs/Variable"}, {"$ref": "#/$defs/Literal"}]},
                                 "required": {"type": "boolean", "default": true, "description": "false compiles to OPTIONAL; an unbound value is reported as null"},
                                 "multiple": {"enum": ["expand", "collect"], "default": "expand", "description": "expand: one candidate combination per value; collect: list on one combination"}}},
    "Filter": {"type": "object", "additionalProperties": false, "minProperties": 1,
               "description": "Restrict a qualifier to listed values; `unbound` (optional qualifiers only) says whether entities lacking the qualifier stay in. Callers may only narrow.",
               "properties": {"values": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Constant"}},
                              "unbound": {"enum": ["include", "exclude"]}}},
    "Binding": {"type": "object", "required": ["id", "patterns"], "additionalProperties": false,
                "properties": {"id": {"type": "string"},
                               "label_predicate": {"type": "string", "description": "Single label predicate (sugar for label_predicates)"},
                               "label_predicates": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Label and alias predicates searched; the match basis names which one matched"},
                               "patterns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/TriplePattern"}},
                               "qualifiers": {"type": "array", "items": {"$ref": "#/$defs/Qualifier"}},
                               "filters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/Filter"}},
                               "languages": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Language tags accepted for labels; empty string admits untagged literals"}}},
    "TermDefinition": {"type": "object", "required": ["id", "definition", "binding"], "additionalProperties": false,
                       "properties": {"id": {"type": "string"}, "definition": {"type": "string"}, "binding": {"$ref": "#/$defs/Binding"}}},
    "TermReference": {"type": "object", "required": ["id", "binding_id", "binding_hash"], "additionalProperties": false,
                      "description": "Compact term identity carried by reports; the full definition is in describe",
                      "properties": {"id": {"type": "string"}, "binding_id": {"type": "string"}, "binding_hash": {"type": "string"}}},
    "InspectionProfile": {"type": "object", "required": ["id", "direction", "predicate"], "additionalProperties": false,
                          "description": "Follow one property from the entity (in: ?node <predicate> <entity>; out: <entity> <predicate> ?node), then report properties of ?node (all when report is empty).",
                          "properties": {"id": {"type": "string"}, "direction": {"enum": ["in", "out"]}, "predicate": {"type": "string"},
                                         "report": {"type": "array", "items": {"type": "string"}}}},
    "ScopeLabels": {"type": "object", "required": ["predicates"], "additionalProperties": false,
                    "description": "Label predicates (and accepted languages) used by the labels operation; defaults to the union of the scope's term label predicates",
                    "properties": {"predicates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                                   "languages": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "ScopeDefinition": {"type": "object", "required": ["id", "source", "graph", "terms"], "additionalProperties": false,
                        "properties": {"id": {"type": "string"}, "source": {"type": "string"}, "graph": {"type": "string"},
                                       "terms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/TermDefinition"}},
                                       "profiles": {"type": "array", "items": {"$ref": "#/$defs/InspectionProfile"}},
                                       "snapshot": {"enum": ["required", "optional"], "default": "optional", "description": "required: every request must carry a snapshot identity"},
                                       "labels": {"$ref": "#/$defs/ScopeLabels"}}},
    "Limits": {"type": "object", "required": ["probe_rows", "inspect_rows", "deadline_ms"], "additionalProperties": false,
               "properties": {"probe_rows": {"type": "integer", "minimum": 1}, "inspect_rows": {"type": "integer", "minimum": 1},
                              "deadline_ms": {"type": "integer", "minimum": 1, "maximum": 2147483647},
                              "unit": {"enum": ["rows", "entities"], "default": "rows", "description": "What probe_rows counts"},
                              "per_entity_rows": {"type": "integer", "minimum": 1, "description": "Entities mode: cap on qualifier combinations per entity (default probe_rows)"},
                              "literal_chars": {"type": "integer", "minimum": 1, "description": "Cut returned literals; truncated ones are marked"},
                              "inspect_batch": {"type": "integer", "minimum": 1, "default": 10, "description": "Max IRIs per inspect_many or labels call"}}},
    "Configuration": {"type": "object", "required": ["scopes", "limits"], "additionalProperties": false,
                      "properties": {"scopes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ScopeDefinition"}},
                                     "limits": {"$ref": "#/$defs/Limits"}}},
    "DescribeRequest": {"type": "object", "required": ["scope"], "additionalProperties": false,
                        "properties": {"scope": {"type": "string"}}},
    "ScopeDescription": {"type": "object", "required": ["id", "source", "graph", "terms", "sparql"], "additionalProperties": false,
                         "properties": {"id": {"type": "string"}, "source": {"type": "string"}, "graph": {"type": "string"},
                                        "terms": {"type": "array", "items": {"$ref": "#/$defs/TermDefinition"}},
                                        "profiles": {"type": "array", "items": {"$ref": "#/$defs/InspectionProfile"}},
                                        "snapshot": {"enum": ["required", "optional"]},
                                        "labels": {"$ref": "#/$defs/ScopeLabels"},
                                        "sparql": {"type": "object", "required": ["graph", "rules", "terms", "example"], "additionalProperties": false,
                                                   "description": "Per-term group-graph-pattern fragments and variable names for composing your own SELECT",
                                                   "properties": {"graph": {"type": "string"}, "rules": {"type": "array", "items": {"type": "string"}},
                                                                  "terms": {"type": "object", "additionalProperties": {"type": "object", "required": ["pattern", "label", "variables"], "additionalProperties": false,
                                                                            "properties": {"pattern": {"type": "string"}, "label": {"type": "string"},
                                                                                           "variables": {"type": "object", "required": ["entity", "label", "label_predicate", "bound", "qualifiers"], "additionalProperties": false,
                                                                                                         "properties": {"entity": {"type": "string"}, "label": {"type": "string"}, "label_predicate": {"type": "string"},
                                                                                                                        "bound": {"type": "object", "additionalProperties": {"type": "string"}},
                                                                                                                        "qualifiers": {"type": "object", "additionalProperties": {"type": "object", "required": ["variable", "required", "multiple"], "additionalProperties": false,
                                                                                                                                       "properties": {"variable": {"type": "string"}, "required": {"type": "boolean"}, "multiple": {"enum": ["expand", "collect"]}}}}}}}}},
                                                                  "example": {"type": "string"}}}}},
    "ProbeRequest": {"type": "object", "required": ["scope", "type"], "additionalProperties": false,
                     "description": "Exactly one of text or iri.",
                     "properties": {"scope": {"type": "string"}, "type": {"type": "string", "description": "A term id from describe"},
                                    "text": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1}}],
                                             "description": "Case-insensitive substring(s) matched against the term's label predicates; a list means alternatives"},
                                    "iri": {"type": "string", "description": "Membership check: does this entity satisfy the term's binding?"},
                                    "filters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/Filter"}, "description": "Narrow configured qualifier filters"},
                                    "snapshot": {"type": "string", "description": "Opaque host revision identity, echoed in the result; required when the scope says so"},
                                    "limit": {"type": "integer", "minimum": 1, "description": "May only lower the host cap"},
                                    "deadline_ms": {"type": "integer", "minimum": 1, "description": "May only lower the host deadline"},
                                    "signal": {"description": "A gluon.CancelSignal (not JSON)"}}},
    "InspectRequest": {"type": "object", "required": ["scope", "iri"], "additionalProperties": false,
                       "properties": {"scope": {"type": "string"}, "iri": {"type": "string", "description": "Absolute IRI; blank nodes are not accepted"},
                                      "profile": {"type": "string", "description": "An inspection profile id from describe.profiles; not combinable with direction/predicate"},
                                      "direction": {"enum": ["in", "out"]}, "predicate": {"type": "string"},
                                      "snapshot": {"type": "string"}, "limit": {"type": "integer", "minimum": 1}, "deadline_ms": {"type": "integer", "minimum": 1},
                                      "signal": {"description": "A gluon.CancelSignal (not JSON)"}}},
    "InspectManyRequest": {"type": "object", "required": ["scope", "iris"], "additionalProperties": false,
                           "properties": {"scope": {"type": "string"}, "iris": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                                          "profile": {"type": "string"}, "direction": {"enum": ["in", "out"]}, "predicate": {"type": "string"},
                                          "snapshot": {"type": "string"}, "limit": {"type": "integer", "minimum": 1}, "deadline_ms": {"type": "integer", "minimum": 1},
                                          "signal": {"description": "A gluon.CancelSignal (not JSON)"}}},
    "LabelsRequest": {"type": "object", "required": ["scope", "iris"], "additionalProperties": false,
                      "properties": {"scope": {"type": "string"}, "iris": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                                     "snapshot": {"type": "string"}, "limit": {"type": "integer", "minimum": 1}, "deadline_ms": {"type": "integer", "minimum": 1},
                                     "signal": {"description": "A gluon.CancelSignal (not JSON)"}}},
    "Completeness": {"type": "object", "required": ["complete", "truncated", "unit", "row_limit", "fetch_limit", "fetched_rows"], "additionalProperties": false,
                     "description": "row_limit/fetch_limit/fetched_rows always count rows; in entities mode row_limit is the outer bound derived from entity_limit and per_entity_limit",
                     "properties": {"complete": {"type": "boolean"}, "truncated": {"type": "boolean"}, "unit": {"enum": ["rows", "entities"]},
                                    "row_limit": {"type": "integer"}, "fetch_limit": {"type": "integer"}, "fetched_rows": {"type": "integer"},
                                    "entity_limit": {"type": "integer"}, "fetched_entities": {"type": "integer"}, "per_entity_limit": {"type": "integer"},
                                    "truncated_entities": {"type": "array", "items": {"type": "string"}}}},
    "SearchRecord": {"type": "object", "required": ["version", "gluon", "operation", "configuration_hash", "scope", "graph", "snapshot", "request", "query"], "additionalProperties": false,
                     "description": "Store this; Discovery.replay(record, snapshot) re-executes it under the same configuration hash.",
                     "properties": {"version": {"const": 2}, "gluon": {"type": "string"}, "operation": {"enum": ["probe", "inspect", "labels"]},
                                    "configuration_hash": {"type": "string"}, "binding_hash": {"type": "string"},
                                    "scope": {"type": "string"}, "graph": {"type": "string"}, "snapshot": {"type": ["string", "null"]},
                                    "request": {"type": "object"}, "query": {"type": "string"}}},
    "Match": {"type": "object", "required": ["predicate", "kind"], "additionalProperties": false,
              "properties": {"predicate": {"type": ["string", "null"]}, "kind": {"enum": ["exact", "substring", "iri"]},
                             "text": {"type": "string", "description": "Which search expression matched"}, "label": {"$ref": "#/$defs/Literal"}}},
    "Candidate": {"type": "object", "required": ["iri", "labels", "matches", "qualifiers", "inspect"], "additionalProperties": false,
                  "properties": {"iri": {"type": "string"}, "labels": {"type": "array", "items": {"$ref": "#/$defs/Literal"}},
                                 "matches": {"type": "array", "items": {"$ref": "#/$defs/Match"}},
                                 "qualifiers": {"type": "object", "description": "name -> Constant | ScopedBlank | null (not recorded) | list (collect mode)"},
                                 "inspect": {"type": "object", "required": ["scope", "iri"], "additionalProperties": false,
                                             "properties": {"scope": {"type": "string"}, "iri": {"type": "string"}}}}},
    "ProbeReport": {"type": "object", "required": ["source", "scope", "graph", "snapshot", "query", "completeness", "record", "outcome", "term", "matching", "filters", "candidates"], "additionalProperties": false,
                    "properties": {"source": {"type": "string"}, "scope": {"type": "string"}, "graph": {"type": "string"}, "snapshot": {"type": ["string", "null"]},
                                   "query": {"type": "string", "description": "Complete scoped SELECT"},
                                   "completeness": {"$ref": "#/$defs/Completeness"}, "record": {"$ref": "#/$defs/SearchRecord"},
                                   "outcome": {"enum": ["matched", "no_match"]},
                                   "term": {"$ref": "#/$defs/TermReference"},
                                   "matching": {"type": "object", "required": ["strategy", "label_predicates", "languages"], "additionalProperties": false,
                                                "properties": {"strategy": {"enum": ["literal-substring", "iri"]}, "texts": {"type": "array", "items": {"type": "string"}}, "iri": {"type": "string"},
                                                               "label_predicates": {"type": "array", "items": {"type": "string"}}, "languages": {"type": ["array", "null"], "items": {"type": "string"}}}},
                                   "filters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/Filter"}, "description": "Every filter applied (configured merged with caller narrowing)"},
                                   "candidates": {"type": "array", "items": {"$ref": "#/$defs/Candidate"}}}},
    "Statement": {"type": "object", "required": ["direction", "predicate", "neighbor"], "additionalProperties": false,
                  "properties": {"direction": {"enum": ["in", "out"]}, "predicate": {"type": "string"},
                                 "neighbor": {"oneOf": [{"$ref": "#/$defs/Iri"}, {"$ref": "#/$defs/Literal"}, {"$ref": "#/$defs/ScopedBlank"}]}}},
    "ProfileStatement": {"type": "object", "required": ["node", "predicate", "value"], "additionalProperties": false,
                         "properties": {"node": {"oneOf": [{"$ref": "#/$defs/Iri"}, {"$ref": "#/$defs/ScopedBlank"}]}, "predicate": {"type": "string"},
                                        "value": {"oneOf": [{"$ref": "#/$defs/Iri"}, {"$ref": "#/$defs/Literal"}, {"$ref": "#/$defs/ScopedBlank"}]}}},
    "InspectReport": {"type": "object", "required": ["source", "scope", "graph", "snapshot", "query", "completeness", "record", "iri", "profile", "filters", "statements"], "additionalProperties": false,
                      "properties": {"source": {"type": "string"}, "scope": {"type": "string"}, "graph": {"type": "string"}, "snapshot": {"type": ["string", "null"]},
                                     "query": {"type": "string"}, "completeness": {"$ref": "#/$defs/Completeness"}, "record": {"$ref": "#/$defs/SearchRecord"},
                                     "iri": {"type": "string"}, "profile": {"type": ["string", "null"]},
                                     "filters": {"type": "object", "additionalProperties": false, "description": "Applied direction/predicate filters; empty when none",
                                                 "properties": {"direction": {"enum": ["in", "out"]}, "predicate": {"type": "string"}}},
                                     "statements": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/Statement"}, {"$ref": "#/$defs/ProfileStatement"}]}}}},
    "LabelsReport": {"type": "object", "required": ["source", "scope", "graph", "snapshot", "query", "completeness", "record", "label_predicates", "languages", "entities"], "additionalProperties": false,
                     "properties": {"source": {"type": "string"}, "scope": {"type": "string"}, "graph": {"type": "string"}, "snapshot": {"type": ["string", "null"]},
                                    "query": {"type": "string"}, "completeness": {"$ref": "#/$defs/Completeness"}, "record": {"$ref": "#/$defs/SearchRecord"},
                                    "label_predicates": {"type": "array", "items": {"type": "string"}}, "languages": {"type": ["array", "null"], "items": {"type": "string"}},
                                    "entities": {"type": "array", "items": {"type": "object", "required": ["iri", "labels"], "additionalProperties": false,
                                                                            "properties": {"iri": {"type": "string"},
                                                                                           "labels": {"type": "array", "items": {"type": "object", "required": ["predicate", "label"], "additionalProperties": false,
                                                                                                                                 "properties": {"predicate": {"type": "string"}, "label": {"$ref": "#/$defs/Literal"}}}}}}}}},
    "Diff": {"type": "object", "required": ["before", "after", "same_query", "added", "removed"], "additionalProperties": false,
             "properties": {"before": {"type": "object"}, "after": {"type": "object"}, "same_query": {"type": "boolean"},
                            "added": {"type": "array"}, "removed": {"type": "array"}}},
    "Diagnostic": {"type": "object", "required": ["code", "message"], "additionalProperties": false,
                   "properties": {"code": {"enum": ["INVALID_CONFIG", "INVALID_REQUEST", "UNKNOWN_SCOPE", "UNKNOWN_TERM", "SOURCE_UNAVAILABLE", "SOURCE_ERROR", "INVALID_RESULT", "DEADLINE_EXCEEDED", "CANCELLED"]},
                                  "message": {"type": "string"}, "path": {"type": "string"}, "detail": {"type": "string"},
                                  "options": {"type": "array", "items": {"type": "string"}}}}
  }
}
